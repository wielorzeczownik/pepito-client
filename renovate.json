{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["github>wielorzeczownik/.github"],
  "customManagers": [
    {
      "customType": "regex",
      "fileMatch": ["^\\.github/workflows/(validate|release)\\.yml$"],
      "matchStrings": ["wasm-bindgen-cli@(?<currentValue>\\d+\\.\\d+\\.\\d+)"],
      "depNameTemplate": "wasm-bindgen-cli",
      "datasourceTemplate": "crate"
    },
    {
      "customType": "regex",
      "fileMatch": ["^Makefile$", "^README\\.md$"],
      "matchStrings": [
        "wasm-bindgen-cli --version (?<currentValue>\\d+\\.\\d+\\.\\d+)"
      ],
      "depNameTemplate": "wasm-bindgen-cli",
      "datasourceTemplate": "crate"
    }
  ],
  "packageRules": [
    {
      "matchDepTypes": ["devDependencies"],
      "semanticCommitType": "build"
    },
    {
      "matchPackageNames": ["wasm-bindgen", "wasm-bindgen-cli"],
      "groupName": "wasm-bindgen"
    },
    {
      "matchPackageNames": ["laravel/pint"],
      "allowedVersions": "<1.30.5"
    },
    {
      "matchPackageNames": ["phpunit/phpunit"],
      "allowedVersions": "<12.0.0"
    },
    {
      "matchPackageNames": ["typescript"],
      "allowedVersions": "<6.1.0"
    }
  ]
}
