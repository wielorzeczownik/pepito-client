{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["group:monorepos", "group:recommended"],
  "platformAutomerge": true,
  "automergeType": "pr",
  "semanticCommits": "enabled",
  "minimumReleaseAge": "3 days",
  "customManagers": [
    {
      "customType": "regex",
      "fileMatch": ["^\\.github/workflows/(validate|release)\\.yml$"],
      "matchStrings": ["wasm-bindgen-cli@(?<currentValue>\\d+\\.\\d+\\.\\d+)"],
      "depNameTemplate": "wasm-bindgen-cli",
      "datasourceTemplate": "crate"
    },
    {
      "customType": "regex",
      "fileMatch": ["^Makefile$", "^README\\.md$"],
      "matchStrings": [
        "wasm-bindgen-cli --version (?<currentValue>\\d+\\.\\d+\\.\\d+)"
      ],
      "depNameTemplate": "wasm-bindgen-cli",
      "datasourceTemplate": "crate"
    },
    {
      "customType": "regex",
      "fileMatch": ["^\\.github/workflows/[^/]+\\.yml$"],
      "matchStrings": ["prettier@(?<currentValue>\\d+\\.\\d+\\.\\d+)"],
      "depNameTemplate": "prettier",
      "datasourceTemplate": "npm"
    },
    {
      "customType": "regex",
      "fileMatch": ["^\\.github/workflows/[^/]+\\.yml$"],
      "matchStrings": [
        "# renovate: datasource=(?<datasource>[a-z-]+) depName=(?<depName>\\S+)\\s+version: (?<currentValue>\\S+)"
      ],
      "versioningTemplate": "semver"
    }
  ],
  "packageRules": [
    {
      "matchUpdateTypes": ["minor", "patch", "pin", "digest"],
      "automerge": true
    },
    {
      "matchDepTypes": ["devDependencies"],
      "semanticCommitType": "build"
    },
    {
      "matchManagers": ["github-actions"],
      "pinDigests": true,
      "minimumReleaseAge": "7 days",
      "semanticCommitType": "ci"
    },
    {
      "matchManagers": ["github-actions"],
      "matchUpdateTypes": ["minor", "patch", "digest"],
      "groupName": "github actions"
    },
    {
      "matchManagers": ["github-actions"],
      "matchPackageNames": [
        "actions/upload-artifact",
        "actions/download-artifact"
      ],
      "groupName": "artifact actions"
    },
    {
      "matchPackageNames": ["wasm-bindgen", "wasm-bindgen-cli"],
      "groupName": "wasm-bindgen"
    }
  ]
}
