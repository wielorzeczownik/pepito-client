{
  "name": "@wielorzeczownik/pepito-client",
  "version": "3.0.0",
  "description": "Pepito API client: SSE events, state, cache and historical statistics. Plain TS, with the Rust core as opt-in wasm.",
  "license": "MIT",
  "type": "module",
  "main": "./dist/pepito.js",
  "types": "./dist/pepito.d.ts",
  "unpkg": "./dist/pepito.umd.js",
  "jsdelivr": "./dist/pepito.umd.js",
  "exports": {
    ".": {
      "types": "./dist/pepito.d.ts",
      "default": "./dist/pepito.js"
    },
    "./wasm": {
      "types": "./dist/wasm.d.ts",
      "default": "./dist/wasm.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "LICENSE"
  ],
  "sideEffects": false,
  "keywords": [
    "pepito",
    "sse",
    "server-sent-events",
    "cat",
    "wasm",
    "rust"
  ],
  "engines": {
    "node": ">=18"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/wielorzeczownik/pepito-client.git",
    "directory": "js"
  },
  "homepage": "https://github.com/wielorzeczownik/pepito-client#readme",
  "bugs": {
    "url": "https://github.com/wielorzeczownik/pepito-client/issues"
  },
  "scripts": {
    "prepack": "node -e \"require('node:fs').copyFileSync('../LICENSE','LICENSE')\"",
    "build": "tsc -p tsconfig.build.json && node scripts/copy-wasm.mjs && vite build -c vite.cdn.config.ts && vite build -c vite.cdn-wasm.config.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "example": "npm run build && node examples/demo.ts",
    "test:watch": "vitest",
    "lint": "eslint src tests scripts examples",
    "fix": "eslint --fix src tests scripts examples"
  },
  "devDependencies": {
    "@types/node": "26.6.2",
    "eslint": "10.11.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-simple-import-sort": "14.0.0",
    "eslint-plugin-sonarjs": "4.2.1",
    "eslint-plugin-unicorn": "76.0.0",
    "jiti": "2.7.0",
    "prettier": "3.9.9",
    "typescript": "6.0.3",
    "typescript-eslint": "8.70.1",
    "vite": "8.3.1",
    "vitest": "5.0.1"
  },
  "author": "wielorzeczownik"
}
