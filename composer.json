{
    "name": "wielorzeczownik/pepito-client",
    "description": "Pepito API client: SSE events, state, cache and historical statistics. Rust core loaded through FFI.",
    "type": "composer-plugin",
    "license": "MIT",
    "require": {
        "php": ">=8.2",
        "ext-ffi": "*",
        "ext-json": "*",
        "ext-curl": "*",
        "ext-phar": "*",
        "ext-zlib": "*",
        "composer-plugin-api": "^2.0",
        "composer-runtime-api": "^2.0",
        "psr/clock": "^1.0",
        "psr/simple-cache": "^1.0 || ^2.0 || ^3.0",
        "psr/http-client": "^1.0",
        "psr/http-factory": "^1.0",
        "psr/http-message": "^1.1 || ^2.0",
        "psr/event-dispatcher": "^1.0",
        "psr/log": "^1.1 || ^2.0 || ^3.0"
    },
    "autoload": {
        "psr-4": {
            "Pepito\\": "php/src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Pepito\\Tests\\": "php/tests/"
        }
    },
    "scripts": {
        "test": "phpunit",
        "lint": "pint --test",
        "format": "pint"
    },
    "extra": {
        "class": "Pepito\\Installer\\LibraryInstallerPlugin"
    },
    "require-dev": {
        "laravel/pint": "1.30.4",
        "nyholm/psr7": "1.8.2",
        "phpunit/phpunit": "13.3.4"
    },
    "suggest": {
        "psr/http-client-implementation": "Your own HTTP client for refresh(), through setHttpClient()",
        "psr/simple-cache-implementation": "Snapshot cache instead of files, through setCache()",
        "psr/event-dispatcher-implementation": "Events from watch(), through setEventDispatcher()"
    },
    "config": {
        "allow-plugins": {
            "wielorzeczownik/pepito-client": true
        },
        "platform": {
            "php": "8.2.33"
        }
    }
}
